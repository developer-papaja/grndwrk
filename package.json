{
  "name": "groundwork",
  "version": "0.0.1",
  "description": "Explore a product idea as a 3D map and find out if you are ready to build",
  "type": "module",
  "bin": {
    "groundwork": "bin/groundwork.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "commands"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "mkdir -p playground && cd playground && tsx ../src/cli.ts init >/dev/null && tsx watch --clear-screen=false --exclude \"../node_modules/**\" --exclude \"../ui/**\" ../src/cli.ts start --dev --no-open",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "open": "^11.0.0",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.17.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "3d-force-graph": "^1.80.1",
    "alpinejs": "^3.17.4",
    "marked": "^18.0.14",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
