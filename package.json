{
  "name": "grndwrk",
  "version": "0.1.1",
  "description": "Explore a product idea as a map of cards and find out if you are ready to build",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developer-papaja/grndwrk.git"
  },
  "homepage": "https://github.com/developer-papaja/grndwrk#readme",
  "bugs": {
    "url": "https://github.com/developer-papaja/grndwrk/issues"
  },
  "type": "module",
  "bin": {
    "grndwrk": "bin/grndwrk.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "commands",
    "overlay",
    "clients/ios/GrndwrkFeedback/Package.swift",
    "clients/ios/GrndwrkFeedback/Sources",
    "clients/ios/GrndwrkFeedback/README.md",
    "clients/ios/Loader",
    "clients/ios/build-loader.sh"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && node scripts/vendor.mjs",
    "dev": "mkdir -p playground && cd playground && tsx ../src/cli.ts init >/dev/null && tsx watch --clear-screen=false --exclude \"../node_modules/**\" --exclude \"../ui/**\" ../src/cli.ts start --dev --no-open",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "open": "11.0.0",
    "playwright-core": "1.64.0",
    "sirv": "3.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.17.0",
    "@types/node": "^26.6.4",
    "@vue/reactivity": "^3.5.43",
    "alpinejs": "^3.17.4",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "modern-screenshot": "4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
